<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash, in the page colour with the Rafiq mark. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/rafiq_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/rafiq_ground</item>
    </style>
</resources>
