# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-export/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Generated Quran artifacts (rebuild with: py data/build_quran.py)
/data/quran.json

# The on-device speech model, bundled at build time (tools/whisper_export/install_model.py)
/mobile/assets/models/*
!/mobile/assets/models/README.md

# GeoNames dumps (large, change daily; fetch with: py data/build_places.py fetch)
/data/raw/geonames/

# Test recitations for the phone, rebuilt by eval/phone_streams.py
/eval/results/phone_streams/

# Audio: never commit recitation recordings, they are large and often rights-encumbered.
# Keep eval manifests (*.jsonl) which reference audio by path/checksum.
/eval/audio/

# Models
*.onnx
*.tflite
*.pt
*.bin

# Flutter (Phase 5)
mobile/.dart_tool/
mobile/build/
mobile/android/.kotlin/
mobile/.flutter-plugins*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Exported on-device models and validation clips (tools/whisper_export)
/build/

# Design handoff archives (kept outside the repo)
/*.zip

# Golden screenshot diffs from a failed run (mobile/test/golden/README.md)
mobile/test/golden/failures/
